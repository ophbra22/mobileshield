# Copy to .env before running `docker compose up` (compose requires this file).
# Values in docker-compose.yml take precedence for the variables it sets.

# dev or prod. prod refuses to start with placeholder/short secrets below.
ENV=dev

# PostgreSQL connection used by the API (only admin/key routes and /readyz need it)
DATABASE_URL=postgresql+psycopg2://mobileshield:mobileshield@db:5432/mobileshield

# Per-client limit for the scan endpoints (requests per minute)
RATE_LIMIT_PER_MINUTE=60

# Comma-separated list of browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Admin endpoint (/admin/create-api-key) is disabled unless ENABLE_ADMIN=true
ENABLE_ADMIN=false
ADMIN_TOKEN=change-me-now
# Optional comma-separated IP allowlist for the admin endpoint
ADMIN_ALLOW_IPS=

# Secrets for JWTs and API-key hashing (32+ characters when ENV=prod).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
SERVER_KEY=change-me-server-key
